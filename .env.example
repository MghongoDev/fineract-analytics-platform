# =====================================================================
# Copy to .env before starting the stack:  cp .env.example .env
#
# Every credential in this file is a LOCAL DEVELOPMENT default. Nothing
# here is a secret and nothing here should ever reach a real deployment -
# in production these come from the platform's secret manager and .env is
# not used at all (see docs/DESIGN_REPORT.md, "Security posture").
# =====================================================================

# ---------------------------------------------------------------------
# Source: Apache Fineract
#
# Pick ONE:
#   a) self-hosted   docker compose --profile fineract up -d
#      FINERACT_BASE_URL=https://fineract:8443/fineract-provider/api/v1
#   b) offline mock  docker compose --profile mock up -d
#      FINERACT_BASE_URL=http://fineract-mock:8090/fineract-provider/api/v1
#   c) public demo   (no profile; needs internet)
#      FINERACT_BASE_URL=https://demo.mifos.io/fineract-provider/api/v1
# ---------------------------------------------------------------------
FINERACT_BASE_URL=https://fineract:8443/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
# Fineract ships a self-signed certificate; set true and mount a CA
# bundle for any real deployment.
FINERACT_VERIFY_SSL=false
FINERACT_AUTH_MODE=basic
FINERACT_PAGE_SIZE=200
FINERACT_MAX_PAGES=500
# Client-side rate limit. Fineract is a live core-banking system: the
# analytics crawler must never be the reason a teller's request queues.
FINERACT_RPS=8
FINERACT_MAX_RETRIES=5
FINERACT_CONNECT_TIMEOUT=10
FINERACT_READ_TIMEOUT=60
FINERACT_DB_PASSWORD=skdcnwauicn2ucnaecasdsajdnizucawencascdca

# ---------------------------------------------------------------------
# OLTP landing database
# ---------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fineract_oltp
POSTGRES_USER=app_ingest
POSTGRES_PASSWORD=app_ingest
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_STATEMENT_TIMEOUT_MS=300000
INGEST_BATCH_SIZE=1000
# Fail an entity's load if more than this fraction of records are
# quarantined - a spike in rejects means the source contract changed.
INGEST_MAX_REJECT_RATIO=0.05

# ---------------------------------------------------------------------
# CDC
# ---------------------------------------------------------------------
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=debezium
KAFKA_CONNECT_URL=http://kafka-connect:8083
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Base64-ish 22-char cluster id required by Kafka in KRaft mode.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ---------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=analytics
CLICKHOUSE_DATABASE=fineract

# ---------------------------------------------------------------------
# dbt
# ---------------------------------------------------------------------
DBT_TARGET=dev
DBT_THREADS=4
DBT_PROJECT_DIR=/opt/airflow/dbt
DBT_PROFILES_DIR=/opt/airflow/dbt

# ---------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------
AIRFLOW_PORT=8085
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------
PROMETHEUS_PORT=9090
PROMETHEUS_PUSHGATEWAY_URL=http://pushgateway:9091
PUSHGATEWAY_PORT=9091
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
EXPORTER_PORT=9105
EXPORTER_SCRAPE_INTERVAL_SECONDS=30
INGEST_PUSH_METRICS=true

# ---------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------
# Host port overrides (change these if something already uses the port)
# ---------------------------------------------------------------------
FINERACT_PORT=8443
FINERACT_MOCK_PORT=8090
KAFKA_PORT=9092
CONNECT_PORT=8083
KAFKA_UI_PORT=8091
